{
  "productName": "Timetipper",
  "version": "0.1.0",
  "identifier": "com.timetipper.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8088",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Timetipper",
        "width": 88,
        "height": 88,
        "minWidth": 88,
        "minHeight": 88,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true,
        "focus": true,
        "visible": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon-256.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/focus_flow.ico"
    ]
  }
}
